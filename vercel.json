{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "destination": "https://www.tenses.id/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "destination": "https://www.tenses.id/:path*",
      "permanent": false
    }
  ]
}
